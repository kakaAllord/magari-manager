{
  "name": "car-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test src/**/*.test.ts",
    "create-manager": "node --env-file-if-exists=.env.local scripts/create-manager.ts",
    "create-director": "node --env-file-if-exists=.env.local scripts/create-manager.ts --director",
    "create-factory-manager": "node --env-file-if-exists=.env.local scripts/create-manager.ts --factory"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
