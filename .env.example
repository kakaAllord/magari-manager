# Copy to .env.local and adjust.
DATABASE_URL=postgres://carmanager:carmanager@localhost:5432/carmanager

# Local or demo copies only: shows the demo login box and lets `npm run db:seed` load demo data.
# Never set it for the live database.
DEMO_MODE=1

# Instant updates (optional). Without these, pages refresh every 10 seconds.
# Create a free Channels app at https://dashboard.pusher.com and copy its keys.
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=mt1
# NEXT_PUBLIC_PUSHER_KEY=      # same value as PUSHER_KEY
# NEXT_PUBLIC_PUSHER_CLUSTER=  # same value as PUSHER_CLUSTER
